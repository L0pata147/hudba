{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonora",
  "version": "0.1.0",
  "identifier": "app.sonora.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sonora",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "backgroundColor": "#08080B",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: http: https:",
        "media-src": "'self' blob: http: https:",
        "connect-src": "'self' ipc: http://ipc.localhost http: https:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Music player for Navidrome",
    "longDescription": "Sonora is a modern, artwork-first music player for your self-hosted Navidrome server.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0NzEyQTRCOTJFRjVDNTAKUldSUVhPK1NTeXB4TkNrZTFRZUtFaUxUQ0xXMmhxU1FlSlJWdmNCQk81NncyUklvd0o3dTMwWHUK",
      "endpoints": [
        "https://github.com/L0pata147/hudba/releases/download/latest-build/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
